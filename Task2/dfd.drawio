get="report"><mxGeometry as="geometry" relative="1" x="0" y="0"><mxPoint as="sourcePoint" x="385" y="1440" /><mxPoint as="targetPoint" x="1860" y="1440" /><Array as="points"><mxPoint x="385" y="1530" /><mxPoint x="1860" y="1530" /></Array><mxPoint as="offset" x="0" y="0" /></mxGeometry></mxCell><mxCell id="e20" style="endArrow=block;strokeWidth=3;dashed=0;html=0;fontSize=23;fontColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=2;exitX=0.3137254901960784;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3137254901960784;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" value="Срез, фильтры" source="user" target="report"><mxGeometry as="geometry" relative="1" x="0" y="0"><mxPoint as="sourcePoint" x="1990" y="1630" /><mxPoint as="targetPoint" x="1990" y="1440" /><Array as="points" /><mxPoint as="offset" x="0" y="0" /></mxGeometry></mxCell><mxCell id="e21" style="endArrow=block;strokeWidth=3;dashed=0;html=0;fontSize=23;fontColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=2;exitX=0.7254901960784313;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7254901960784313;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" value="Отчёт" source="report" target="user"><mxGeometry as="geometry" relative="1" x="0" y="0"><mxPoint as="sourcePoint" x="2200" y="1440" /><mxPoint as="targetPoint" x="2200" y="1630" /><Array as="points" /><mxPoint as="offset" x="0" y="0" /></mxGeometry></mxCell><mxCell id="note0" value="Медицинские данные и результаты ИИ остаются в D1/D3 и обмене между рабочими сервисами.&#10;Каждый домен сам выполняет процесс 5: выбирает поля, проверяет качество и готовит показатели.&#10;Прямоугольник — внешний участник; скруглённый блок — процесс; бежевый блок D — хранилище.&#10;Пунктир показывает планируемый обмен. Dremio читает наборы D4, каталог D5 хранит их описания." style="text;html=0;align=left;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1640" width="2310" height="120" /></mxCell></root></mxGraphModel></diagram></mxfile>