        <mxCell id="label24" parent="1" style="text;html=0;whiteSpace=wrap;fontSize=23;fillColor=#ffffff;" value="OIDC: вход в Power BI" vertex="1">
          <mxGeometry height="38" width="250" x="1955" y="1933" as="geometry" />
        </mxCell>
        <mxCell id="note0" parent="1" style="text;html=0;align=left;fontSize=23;" value="Клиника и ИИ обмениваются медицинскими данными через закрытый API. Клиника передаёт счёт в финтех через API.&#10;Бизнес-правила выполняют сервисы доменов. Форматно-логический контроль (ФЛК) проверяет поля, типы и версию схемы.&#10;PowerBuilder и Camel продолжают работать в старых системах. Связи Camel переносим по одной после проверки результата, повторов и сбоев." vertex="1">
          <mxGeometry height="120" width="2310" x="60" y="2295" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="text;html=0;align=left;fontSize=23;" value="Внутри границ системы находятся свои приложения и платформа «Будущее 2.0». API и БД партнёров находятся снаружи.&#10;При публикации описания данных передаются в DataHub, а таблицы регистрируются в Nessie.&#10;У доменов свои владельцы и ресурсы. Отчёты используют готовые наборы. Для нового бизнеса согласуется контракт. Медицинские данные в витрины не попадают." vertex="1">
          <mxGeometry height="120" width="2310" x="60" y="2170" as="geometry" />
        </mxCell>
        <mxCell id="label4" parent="1" style="text;html=0;whiteSpace=wrap;fontSize=23;fillColor=#ffffff;" value="Чтение / запись" vertex="1">
          <mxGeometry height="30" width="180" x="800" y="776" as="geometry" />
        </mxCell>
        <mxCell id="event-title" parent="1" value="Потоковая обработка статуса оплаты" style="text;html=0;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#17485D;" vertex="1">
          <mxGeometry x="90" y="124" width="2160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="clinic-consumer" parent="1" value="Обработчик событий клиники&#10;ФЛК и преобразование статуса&#10;Проверка дублей по ID события" style="rounded=0;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#216682;strokeWidth=1.5;fontColor=#111111;fontSize=26;" vertex="1">
          <mxGeometry x="94" y="181" width="465" height="126" as="geometry" />
        </mxCell>
        <mxCell id="payment-queue" parent="1" value="Очередь событий&#10;Доставляет статус оплаты" style="rounded=0;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#216682;strokeWidth=1.5;fontColor=#111111;fontSize=26;" vertex="1">
          <mxGeometry x="775" y="181" width="355" height="126" as="geometry" />
        </mxCell>
        <mxCell id="reliability-note" parent="1" value="API-клиенты задают таймауты и повторяют вызовы при временных сбоях.&#10;Обработчик повторяет обработку при временных ошибках.&#10;События, которые обработать не удалось, попадают в очередь ошибок." style="text;html=0;align=left;verticalAlign=middle;fontSize=23;fontColor=#17485D;" vertex="1">
          <mxGeometry x="1238" y="177" width="1025" height="133" as="geometry" />
        </mxCell>
        <mxCell id="event-publish" parent="1" source="Финтехa" target="payment-queue" value="Публикует статус оплаты" style="edgeStyle=segmentEdgeStyle;rounded=1;html=0;strokeWidth=3;dashed=1;dashPattern=7 5;strokeColor=#216682;fontColor=#17485D;fontSize=23;endArrow=block;endFill=1;labelBackgroundColor=#F0F6FA;labelBorderColor=none;exitX=0;exitY=0.31;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1">
          <mxGeometry x="0.66" y="0" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="638" />
              <mxPoint x="610" y="344" />
              <mxPoint x="952" y="344" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="event-delivery" parent="1" source="payment-queue" target="clinic-consumer" value="Статус оплаты" style="edgeStyle=segmentEdgeStyle;rounded=1;html=0;strokeWidth=3;dashed=1;dashPattern=7 5;strokeColor=#216682;fontColor=#17485D;fontSize=23;endArrow=block;endFill=1;labelBackgroundColor=#F0F6FA;labelBorderColor=none;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1">
          <mxGeometry x="0" y="0" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="event-apply" parent="1" source="clinic-consumer" target="Клиникиa" value="Передаёт статус" style="edgeStyle=segmentEdgeStyle;rounded=1;html=0;strokeWidth=3;dashed=1;dashPattern=7 5;strokeColor=#216682;fontColor=#17485D;fontSize=23;endArrow=block;endFill=1;labelBackgroundColor=#F0F6FA;labelBorderColor=none;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0;entryY=0.67;entryPerimeter=0;" edge="1">
          <mxGeometry x="-0.52" y="0" relative="1" as="geometry">
