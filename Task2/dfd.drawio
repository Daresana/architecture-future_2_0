<mxfile><diagram name="Будущее 2.0 — DFD: операционные и аналитические потоки"><mxGraphModel pageWidth="2400" pageHeight="1880" grid="1" page="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Будущее 2.0 — DFD: операционные и аналитические потоки" style="text;html=0;fontSize=40;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="20" width="2300" height="70" /></mxCell><mxCell id="operator" value="Оператор клиники" style="rounded=0;whiteSpace=wrap;html=0;fontSize=27;fillColor=#f2f2f2;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="140" width="440" height="110" /></mxCell><mxCell id="clinic" value="1. Вести приём&#10;и формировать счёт" style="rounded=1;whiteSpace=wrap;html=0;fontSize=27;fillColor=#e8f0f7;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="400" width="440" height="140" /></mxCell><mxCell id="clinicdb" value="D1. Медицинские данные&#10;и учёт клиники" style="rounded=0;whiteSpace=wrap;html=0;fontSize=27;fillColor=#f5f0e5;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="720" width="440" height="140" /></mxCell><mxCell id="fin" value="2. Обработать платёж&#10;или кредит" style="rounded=1;whiteSpace=wrap;html=0;fontSize=27;fillColor=#e8f0f7;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="400" width="440" height="140" /></mxCell><mxCell id="findb" value="D2. Финансовые данные" style="rounded=0;whiteSpace=wrap;html=0;fontSize=27;fillColor=#f5f0e5;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="720" width="440" height="140" /></mxCell><mxCell id="ai" value="3. Обработать&#10;медицинский запрос" style="rounded=1;whiteSpace=wrap;html=0;fontSize=27;fillColor=#e8f0f7;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="400" width="440" height="140" /></mxCell><mxCell id="aidb" value="D3. Данные для ИИ и&#10;результаты обработки" style="rounded=0;whiteSpace=wrap;html=0;fontSize=27;fillColor=#f5f0e5;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="720" width="440" height="140" /></mxCell><mxCell id="partner" value="Фармацевтика / электроника" style="rounded=0;whiteSpace=wrap;html=0;fontSize=27;fillColor=#f2f2f2;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="1920" y="140" width="420" height="110" /></mxCell><mxCell id="partners" value="4. Принять сведения&#10;поставок и устройств" style="rounded=1;whiteSpace=wrap;html=0;fontSize=27;fillColor=#e8f0f7;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="1920" y="400" width="420" height="140" /></mxCell><mxCell id="publish" value="5. Подготовить данные домена: выбрать поля, проверить качество, рассчитать показатели&#10;Клиники: загрузка и выручка; финтех: финансовые показатели; ИИ: технические показатели; партнёры: поставки / устройства" style="rounded=1;whiteSpace=wrap;html=0;fontSize=27;fillColor=#e8f0f7;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1010" width="2280" height="140" /></mxCell><mxCell id="data" value="D4. Данные доменов для отчётов&#10;Без карт, историй и исследований" style="rounded=0;whiteSpace=wrap;html=0;fontSize=27;fillColor=#f5f0e5;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1300" width="650" height="140" /></mxCell><mxCell id="meta" value="D5. Каталог метаданных&#10;Владелец, контракт, lineage" style="rounded=0;whiteSpace=wrap;html=0;fontSize=27;fillColor=#f5f0e5;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="1300" width="650" height="140" /></mxCell><mxCell id="report" value="6. Проверить доступ&#10;и построить отчёт" style="rounded=1;whiteSpace=wrap;html=0;fontSize=27;fillColor=#e8f0f7;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="1830" y="1300" width="510" height="140" /></mxCell><mxCell id="user" value="Сотрудник / аналитик" style="rounded=0;whiteSpace=wrap;html=0;fontSize=27;fillColor=#f2f2f2;strokeColor=#425466;" vertex="1" parent="1"><mxGeometry as="geometry" x="1830" y="1630" width="510" height="110" /></mxCell><mxCell id="e0" style="endArrow=block;strokeWidth=3;dashed=0;html=0;fontSize=23;fontColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" value="Данные приёма" source="operator" target="clinic"><mxGeometry as="geometry" relative="1" x="0" y="0"><mxPoint as="sourcePoint" x="280" y="250" /><mxPoint as="targetPoint" x="280" y="400" /><Array as="points" /><mxPoint as="offset" x="0" y="0" /></mxGeometry></mxCell><mxCell id="e1" style="endArrow=block;strokeWidth=3;dashed=0;html=0;fontSize=23;fontColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=2;exitX=1.0;exitY=0.21428571428571427;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.21428571428571427;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" value="Счёт, сумма" source="clinic" target="fin"><mxGeometry as="geometry" relative="1" x="0" y="0"><mxPoint as="sourcePoint" x="500" y="430" /><mxPoint as="targetPoint" x="680" y="430" /><Array as="points" /><mxPoint as="offset" x="0" y="0" /></mxGeometry></mxCell><mxCell id="e2" style="endArrow=block;strokeWidth=3;dashed=0;html=0;fontSize=23;fontColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=2;exitX=0.0;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" value="Статус оплаты" source="fin" target="clinic"><mxGeometry as="geometry" relative="1" x="0" y="0"><mxPoint as="sourcePoint" x="680" y="505" /><mxPoint as="targetPoint" x="500" y="505" /><Array as="points" /><mxPoint as="offset" x="0" y="0" /></mxGeometry></mxCell><mxCell id="e3" style="endArrow=block;strokeWidth=3